# ── Telegram (server-side only — NEVER exposed to the browser) ─────────────
# Create a bot with @BotFather on Telegram and copy the token it gives you.
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Create a PRIVATE Telegram group, add your bot to it, and promote the bot
# to admin with "Pin Messages" permission. Then send any message in the
# group and read https://api.telegram.org/bot<token>/getUpdates in a browser
# to find "chat":{"id": ...} — that number (often negative, e.g. -1001234567890)
# is your chat ID.
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ── Admin authentication ────────────────────────────────────────────────────
# Never put a plain password here. Run `npm run generate-admin-hash` and
# paste the printed value below.
ADMIN_PASSWORD_HASH=

# Random long string used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Website address (SEO) ───────────────────────────────────────────────────
# Your real public address, with https. Used for sitemap.xml, canonical links
# and the WhatsApp/Facebook preview image. On Vercel it falls back to the
# project's production URL automatically, but set it once you buy a domain.
SITE_URL=https://your-domain.example

# ── Contact-form spam protection: Cloudflare Turnstile (free) ──────────────
# dash.cloudflare.com > Turnstile > Add widget > copy both keys.
# (For local testing use the always-pass dummy pair:
#  site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Analytics 4 ─────────────────────────────────────────────────────
# analytics.google.com > Admin > Data streams > Web > Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# ── E-mail (sign-up verification codes) ────────────────────────────────────
# Free: brevo.com (300 mails/day). Create an account > SMTP & API > API keys,
# and under Senders add + verify the address you want codes to come from.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=बेलानगर सरस्वती पूजा समिति
# Optional: extra temp-mail domains to block (comma separated)
DISPOSABLE_EXTRA=

# ── Sign in with Google / Microsoft (Hotmail, Outlook, Live) ───────────────
# Redirect URI to register at BOTH providers:  <SITE_URL>/api/users/oauth-callback
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: entra.microsoft.com > App registrations > New (accounts: "any org + personal"),
#            Certificates & secrets > New client secret (use the secret VALUE)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
